{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodreader",
  // tong.lucas@gmail.com 底下有不只一個 Cloudflare 帳號，不釘死的話 wrangler 會挑錯
  // 帳號，deploy 與 d1 migrations 會失敗（10000 / 7403）
  "account_id": "06cc330d909e576dc8b21ed254649b02",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  // global_fetch_strictly_public：fetch 只能連公網，擋掉內網位址（防 SSRF）
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "goodreader" },
    // lucasact 帳號服務：登入、Token 錢包（Service Binding，不經過公網）
    { "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "AccountsService" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goodreader-db",
      // 執行 `npx wrangler d1 create goodreader-db` 後把 id 貼到這裡
      "database_id": "d0805e0a-4ffb-4576-bcdb-c9e92df88a19",
      "migrations_dir": "migrations"
    }
  ],
  // 之後接白名單收集器時再開 R2（存原始 HTML 快照）：
  // "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "goodreader-snapshots" }],
  "vars": {
    "LLM_BASE_URL": "https://api.deepinfra.com/v1/openai",
    "GRADER_MODEL": "deepseek-ai/DeepSeek-V4-Flash",
    "KEYPOINT_MODEL": "deepseek-ai/DeepSeek-V4-Flash",
    "RUBRIC_VERSION": "2026-09-demo-1",
    "LLM_MOCK": "0",
    "ACCOUNTS_URL": "https://accounts.lucasact.com",
    "PUBLIC_URL": "https://goodreader.lucasact.com"
  },
  "observability": { "enabled": true }
}
