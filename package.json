{
  "name": "goodreader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --strict-vars=false --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply goodreader-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply goodreader-db --remote",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:ci": "wrangler d1 migrations apply goodreader-db --remote && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "linkedom": "^0.18.13",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9",
    "wrangler": "^4.135.0"
  }
}
